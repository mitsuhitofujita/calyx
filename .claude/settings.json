{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(pnpm lint)",
            "Bash(pnpm e2e *)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./.local/*)"
        ],
        "ask": [
            "Bash(git add *)",
            "Bash(git push *)"
        ]
    },
    "plansDirectory": "./docs/plans"
}